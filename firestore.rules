rules_version = '2';

// Memento — Firestore güvenlik kuralları
//
// Deploy:  firebase deploy --only firestore:rules,firestore:indexes
//
// SAYAÇ İLKESİ: Hiçbir sayaç (karma, likes, follower_count, following_count,
// quote_count) "çıplak" artırılamaz. Her ±1, aynı batch içinde gerçekten
// oluşan / silinen bir kayda bağlı. Bunu doğrulamak için yazmaya bir
// "*_src" alanı eklenir (hangi kaydın sayacı değiştirdiği) ve kural o
// kaydın batch'ten önce ve sonra var olup olmadığına bakar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid()        { return request.auth.uid; }

    // Yönetici: admins/{uid} belgesi olan hesap. Bu belge yalnızca Firebase
    // konsolundan / yönetici araçlarından eklenir, uygulamadan yazılamaz.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }
    // Yönetici tarafından yasaklanan hesap söz paylaşamaz.
    function isBanned() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('banned', false) == true;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyFields(fields) { return changed().hasOnly(fields); }

    function delta(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0);
    }

    // Kayıt bu batch'te oluşturuldu mu / silindi mi?
    function created(path) { return !exists(path) && existsAfter(path); }
    function removed(path) { return exists(path) && !existsAfter(path); }

    function isFollowerOf(ownerId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/followers/$(uid()));
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ---------------------------------------------------------------
    // YÖNETİCİLER — yalnızca kişi kendi kaydını görebilir (panel girişi için)
    // ---------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn() && adminId == uid();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // KULLANICI ADLARI — benzersizlik kilidi
    // ---------------------------------------------------------------
    match /usernames/{name} {
      allow read: if true;
      // Sadece kendi profiline yazdığın adı kilitleyebilirsin — boşta ad
      // toplamak (squatting) mümkün değil.
      allow create: if isSignedIn()
                    && name.matches('^[a-z0-9_]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == uid()
                    && getAfter(/databases/$(database)/documents/users/$(uid())).data.username_lower == name;
      allow delete: if isSignedIn() && resource.data.uid == uid();

      // Sahipsiz kilidi devralma: kilidin sahibi silinmiş ya da başka bir
      // ada geçmişse, ad yeniden alınabilir. Kendi kilidini yenilemek de serbest.
      allow update: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == uid()
                    && getAfter(/databases/$(database)/documents/users/$(uid())).data.username_lower == name
                    && (resource.data.uid == uid()
                        || !exists(/databases/$(database)/documents/users/$(resource.data.uid))
                        || get(/databases/$(database)/documents/users/$(resource.data.uid)).data.get('username_lower', '') != name);
    }

    // ---------------------------------------------------------------
    // KULLANICILAR
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;   // Profiller ve zirve listesi herkese açık.

      allow create: if isSignedIn()
                    && userId == uid()
                    && request.resource.data.keys().hasOnly(
                         ['uid','username','username_lower','display_name','bio',
                          'link','photo_url','karma','quote_count',
                          'follower_count','following_count','created_at'])
                    && request.resource.data.uid == uid()
                    && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,20}$')
                    && request.resource.data.username_lower == request.resource.data.username.lower()
                    && request.resource.data.karma == 0
                    && request.resource.data.quote_count == 0
                    && request.resource.data.follower_count == 0
                    && request.resource.data.following_count == 0;

      function validProfile() {
        let d = request.resource.data;
        return d.username.matches('^[a-zA-Z0-9_]{3,20}$')
            && d.username_lower == d.username.lower()
            && str(d.display_name, 0, 40)
            && str(d.bio, 0, 160)
            && str(d.link, 0, 120)
            // Ad değiştiyse yeni ad bu batch'te bu kullanıcıya kilitlenmiş olmalı.
            && (d.username_lower == resource.data.username_lower
                || getAfter(/databases/$(database)/documents/usernames/$(d.username_lower)).data.uid == uid());
      }

      allow update: if isSignedIn() && (
        // 1) Sahibi profilini düzenler — sayaçlara dokunamaz.
        (userId == uid()
          // 'email' yalnızca SİLİNEBİLİR: eski sürüm e-postayı herkese açık
          // profile yazıyordu, giriş anında temizleniyor.
          && onlyFields(['username','username_lower','display_name','bio','link','updated_at','email'])
          && !('email' in request.resource.data)
          && validProfile())
        ||
        // 1b) Eski e-posta alanını silme.
        (userId == uid()
          && onlyFields(['email'])
          && !('email' in request.resource.data))
        ||
        // 2) Profil fotoğrafı — sadece kendi Storage yolundaki dosya.
        (userId == uid()
          && onlyFields(['photo_url'])
          && (request.resource.data.photo_url == null
              || request.resource.data.photo_url.matches('^avatar:' + uid() + ':[0-9]{10,16}$')
              || request.resource.data.photo_url.matches(
                   '^https://firebasestorage\\.googleapis\\.com/.*profile_photos%2F' + uid() + '\\.jpg.*')))
        ||
        // 2b) Profile sabitlenen söz.
        (userId == uid()
          && onlyFields(['pinned'])
          && (request.resource.data.pinned == null
              || (request.resource.data.pinned is map
                  && request.resource.data.pinned.keys().hasOnly(['id','text','author','text_en','author_en','user_id','owner_username','color'])
                  && str(request.resource.data.pinned.text, 1, 400)
                  && str(request.resource.data.pinned.author, 0, 80))))
        ||
        // 3) Söz sayacı: aynı batch'te sahibinin sözü oluştu / silindi.
        (userId == uid()
          && onlyFields(['quote_count','quote_src'])
          && ((delta('quote_count') == 1
                && created(/databases/$(database)/documents/quotes/$(request.resource.data.quote_src)))
           || (delta('quote_count') == -1
                && removed(/databases/$(database)/documents/quotes/$(request.resource.data.quote_src)))))
        ||
        // 4) Karma: bu kullanıcının bir sözüne aynı batch'te beğeni geldi / gitti.
        (userId != uid()
          && onlyFields(['karma','karma_src'])
          && get(/databases/$(database)/documents/quotes/$(request.resource.data.karma_src)).data.user_id == userId
          && ((delta('karma') == 1
                && created(/databases/$(database)/documents/quotes/$(request.resource.data.karma_src)/likes/$(uid())))
           || (delta('karma') == -1
                && removed(/databases/$(database)/documents/quotes/$(request.resource.data.karma_src)/likes/$(uid())))))
        ||
        // 5) Takipçi sayacı: aynı batch'te takip kaydı oluştu / silindi.
        (onlyFields(['follower_count'])
          && ((delta('follower_count') == 1
                && created(/databases/$(database)/documents/users/$(userId)/followers/$(uid())))
           || (delta('follower_count') == -1
                && removed(/databases/$(database)/documents/users/$(userId)/followers/$(uid())))))
        ||
        // 5b) Takipçi çıkarma: profil sahibi kendi takipçi sayacını, o
        //     takipçinin kaydını aynı batch'te silerek düşürür.
        (userId == uid()
          && onlyFields(['follower_count','follower_src'])
          && delta('follower_count') == -1
          && removed(/databases/$(database)/documents/users/$(uid())/followers/$(request.resource.data.follower_src)))
        ||
        // 6b) Takipçi çıkarma, karşı taraf: çıkarılan kişinin "takip
        //     ettiklerim" sayacı, beni takip kaydı aynı batch'te silinirken düşer.
        (userId != uid()
          && onlyFields(['following_count','following_src'])
          && request.resource.data.following_src == uid()
          && delta('following_count') == -1
          && removed(/databases/$(database)/documents/users/$(userId)/following/$(uid())))
        ||
        // 7) Yönetici: hesabı yasaklar / yasağı kaldırır.
        (isAdmin()
          && onlyFields(['banned', 'banned_at'])
          && request.resource.data.banned is bool)
        ||
        // 6) Takip edilen sayacı.
        (userId == uid()
          && onlyFields(['following_count','following_src'])
          && ((delta('following_count') == 1
                && created(/databases/$(database)/documents/users/$(uid())/following/$(request.resource.data.following_src)))
           || (delta('following_count') == -1
                && removed(/databases/$(database)/documents/users/$(uid())/following/$(request.resource.data.following_src)))))
      );

      // Hesap silme (App Store zorunluluğu).
      allow delete: if isSignedIn() && userId == uid();

      // Memento defteri: günde bir söz + kısa not. Yalnızca sahibi görür.
      match /journal/{day} {
        allow read, delete: if isSignedIn() && userId == uid();
        allow create, update: if isSignedIn() && userId == uid()
                      && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && request.resource.data.keys().hasOnly(['quote', 'note', 'created_at'])
                      && request.resource.data.note is string
                      && request.resource.data.note.size() <= 280
                      && request.resource.data.quote is map
                      && request.resource.data.quote.keys().hasOnly(
                           ['id','text','author','text_en','author_en','lang','user_id',
                            'owner_username','owner_photo_url','likes','privacy','color'])
                      && str(request.resource.data.quote.text, 1, 400);
      }
      match /saved/{quoteId} {
        allow read, write: if isSignedIn() && userId == uid();
      }
      match /liked/{quoteId} {
        allow read, write: if isSignedIn() && userId == uid();
      }
      match /blocked/{blockedId} {
        allow read, write: if isSignedIn() && userId == uid();
      }

      // Uygulama içi bildirimler. İşlemi yapan yazar; kural işlemin gerçekten
      // olduğunu ve kimliğin taklit edilmediğini doğrular. Kimlik sabit
      // (like_<söz>_<kişi>, follow_<kişi>) → aynı olay için ikinci bildirim yok.
      match /notifications/{notifId} {
        function actorOk(d) {
          let me = get(/databases/$(database)/documents/users/$(uid())).data;
          return d.actor_uid == uid()
              && d.actor_username == me.username
              && d.get('actor_photo_url', null) == me.get('photo_url', null)
              && d.created_at == request.time
              && d.read == false;
        }
        allow read: if isSignedIn() && userId == uid();
        allow create: if isSignedIn() && userId != uid() && (
          (notifId == 'follow_' + uid()
            && request.resource.data.keys().hasOnly(
                 ['type','actor_uid','actor_username','actor_photo_url','created_at','read'])
            && request.resource.data.type == 'follow'
            && actorOk(request.resource.data)
            && exists(/databases/$(database)/documents/users/$(userId)/followers/$(uid())))
          ||
          (request.resource.data.keys().hasOnly(
                 ['type','actor_uid','actor_username','actor_photo_url','created_at','read','quote_id','quote_text'])
            && request.resource.data.type == 'like'
            && notifId == 'like_' + request.resource.data.quote_id + '_' + uid()
            && str(request.resource.data.quote_text, 1, 160)
            && actorOk(request.resource.data)
            && get(/databases/$(database)/documents/quotes/$(request.resource.data.quote_id)).data.user_id == userId
            && exists(/databases/$(database)/documents/quotes/$(request.resource.data.quote_id)/likes/$(uid())))
        );
        // Alıcı yalnızca okundu işaretleyebilir ve silebilir.
        allow update: if isSignedIn() && userId == uid()
                      && onlyFields(['read']) && request.resource.data.read is bool;
        allow delete: if isSignedIn() && (userId == uid() || resource.data.actor_uid == uid());
      }

      // Takip grafiği. İki kayıt da yalnızca takip EDEN tarafından yazılır.
      // Silmeye, hesabını silen karşı taraf da izinli (temizlik için).
      match /following/{targetId} {
        allow read: if true;
        allow create: if isSignedIn() && userId == uid() && targetId != uid()
                      && request.resource.data.keys().hasOnly(['uid','created_at']);
        allow delete: if isSignedIn() && (userId == uid() || targetId == uid());
      }
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isSignedIn() && followerId == uid() && userId != uid()
                      && request.resource.data.keys().hasOnly(['uid','created_at']);
        allow delete: if isSignedIn() && (followerId == uid() || userId == uid());
      }
    }

    // ---------------------------------------------------------------
    // PROFİL FOTOĞRAFLARI — Firestore'da küçük JPEG (base64). Storage
    // faturalandırma olmadan kilitlendiği için fotoğraflar burada.
    // ---------------------------------------------------------------
    match /avatars/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && userId == uid()
                    && request.resource.data.keys().hasOnly(['data', 'updated_at'])
                    && request.resource.data.data is string
                    && request.resource.data.data.size() > 100
                    && request.resource.data.data.size() < 210000
                    && request.resource.data.data.matches('^(/9j/|iVBOR).*');
      allow delete: if isSignedIn() && userId == uid();
    }

    // ---------------------------------------------------------------
    // SÖZLER
    // ---------------------------------------------------------------
    match /quotes/{quoteId} {

      function q() { return resource.data; }

      // Liste sorgularında bu kural dönen HER döküman için çalışır;
      // sorgunun kendisi de filtreli olmalı.
      allow read: if q().privacy == 'Herkese Açık'
                  || isAdmin()
                  || (isSignedIn() && q().user_id == uid())
                  || (isSignedIn()
                      && q().privacy == 'Takipçilerim'
                      && isFollowerOf(q().user_id));

      function validQuote(d) {
        return str(d.text, 1, 280)
            && str(d.author, 1, 60)
            && d.privacy in ['Herkese Açık', 'Takipçilerim', 'Yalnızca Ben']
            && d.get('lang', 'tr') in ['tr', 'en']
            // Kart rengi: paletteki 8 renkten birinin sırası (isteğe bağlı).
            && (!('color' in d) || (d.color is int && d.color >= 0 && d.color <= 7));
      }

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['text','author','privacy','lang','user_id',
                          'owner_username','owner_photo_url','likes','color','created_at'])
                    && request.resource.data.user_id == uid()
                    && request.resource.data.likes == 0
                    && request.resource.data.created_at == request.time
                    && validQuote(request.resource.data)
                    // Yazar adı taklit edilemez: profildeki kullanıcı adı olmalı.
                    && request.resource.data.owner_username ==
                       get(/databases/$(database)/documents/users/$(uid())).data.username
                    && !isBanned();

      allow update: if isSignedIn() && (
        // Sahibi düzenler — beğeni sayısına dokunamaz.
        (q().user_id == uid()
          && onlyFields(['text','author','privacy','lang','color','owner_username','owner_photo_url','updated_at'])
          && validQuote(request.resource.data)
          && (!('owner_username' in changed())
              || request.resource.data.owner_username ==
                 get(/databases/$(database)/documents/users/$(uid())).data.username))
        ||
        // Beğeni sayacı: aynı batch'te bu kullanıcının beğeni kaydı oluştu / silindi.
        (onlyFields(['likes'])
          && ((delta('likes') == 1
                && created(/databases/$(database)/documents/quotes/$(quoteId)/likes/$(uid())))
           || (delta('likes') == -1
                && removed(/databases/$(database)/documents/quotes/$(quoteId)/likes/$(uid())))))
      );

      // Sahibi ya da yönetici (şikâyet üzerine) silebilir.
      allow delete: if isSignedIn() && (q().user_id == uid() || isAdmin());

      // Kim neyi beğendi. Kimlik = beğenenin uid'si → çift beğeni imkânsız.
      // Beğeni kaydı ile sayaç ayrı ayrı oynanamaz: kayıt da sayacın
      // aynı batch'te değişmesini şart koşuyor.
      match /likes/{likerId} {
        allow read: if isSignedIn() && likerId == uid();
        allow create: if isSignedIn()
                      && likerId == uid()
                      && request.resource.data.keys().hasOnly(['user_id','created_at'])
                      && request.resource.data.user_id == uid()
                      && getAfter(/databases/$(database)/documents/quotes/$(quoteId)).data.likes
                         == get(/databases/$(database)/documents/quotes/$(quoteId)).data.likes + 1;
        allow delete: if isSignedIn()
                      && likerId == uid()
                      && (!existsAfter(/databases/$(database)/documents/quotes/$(quoteId))
                          || getAfter(/databases/$(database)/documents/quotes/$(quoteId)).data.likes
                             == get(/databases/$(database)/documents/quotes/$(quoteId)).data.likes - 1);
        allow update: if false;
      }
    }

    // ---------------------------------------------------------------
    // ŞİKÂYETLER — yazılır, okunmaz. Sadece konsoldan incelenir.
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['quote_id','owner_id','reporter_id','reason','status','created_at'])
                    && request.resource.data.get('status', 'open') == 'open'
                    && request.resource.data.reporter_id == uid()
                    && request.resource.data.reason in
                       ['report_spam','report_hate','report_violence','report_sexual','report_other'];
      // Yönetim paneli: yöneticiler okur, kapatır, siler.
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && onlyFields(['status', 'handled_at', 'handled_by'])
                    && request.resource.data.status in ['open', 'removed', 'dismissed', 'banned'];
    }
  }
}
