<?xml version="1.0" encoding="utf-8"?>
<!-- Günün sözü (büyük, 4x2). Zemin ve yazı rengi her gün sözün renginden gelir. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_round"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bricolage_extrabold"
                android:text="Bugün senin için"
                android:textColor="#FF2A1460"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_extrabold"
                android:text="memento"
                android:textColor="#FF2A1460"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:fontFamily="@font/bricolage_extrabold"
            android:text="Yedi kere düş, sekiz kere kalk."
            android:textColor="#FF2A1460"
            android:textSize="22sp"
            android:lineSpacingMultiplier="0.95"
            android:ellipsize="end"
            android:maxLines="4" />

        <TextView
            android:id="@+id/widget_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/bricolage_semibold"
            android:text="Japon Atasözü"
            android:textColor="#FF2A1460"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
