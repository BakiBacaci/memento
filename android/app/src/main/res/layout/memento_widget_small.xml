<?xml version="1.0" encoding="utf-8"?>
<!-- Günün sözü (küçük, 2x2). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_round"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_extrabold"
            android:text="memento"
            android:textColor="#FF24400A"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:fontFamily="@font/bricolage_extrabold"
            android:text="Damlaya damlaya göl olur."
            android:textColor="#FF24400A"
            android:textSize="17sp"
            android:lineSpacingMultiplier="0.95"
            android:ellipsize="end"
            android:maxLines="5" />
    </LinearLayout>
</FrameLayout>
