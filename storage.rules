rules_version = '2';

// Memento — Firebase Storage kuralları (profil fotoğrafları)
//
// Deploy:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{userId} {
      // Avatarlar herkese görünür.
      allow read: if true;

      // Sadece kendi fotoğrafını, sadece görsel olarak, en fazla 5 MB.
      // Uygulama zaten 512x512'ye küçültüp gönderiyor; bu üst sınır
      // doğrudan Storage API'sine yapılacak yüklemelere karşı.
      // Dosya adı tam olarak <uid>.jpg olmalı — başka birinin uid'siyle
      // başlayan bir ad (ör. <uid>X.jpg) kabul edilmez.
      allow create, update: if request.auth != null
                   && userId == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Hesap silinirken fotoğraf da silinir.
      allow delete: if request.auth != null
                    && userId == request.auth.uid + '.jpg';
    }

    // Başka hiçbir yola yazılamaz.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
