rules_version = '2';

// Memento — Firebase Storage kuralları (profil fotoğrafları)
//
// Deploy:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{userId} {
      // Avatarlar herkese görünür.
      allow read: if true;

      // Sadece kendi fotoğrafını, sadece görsel olarak, en fazla 5 MB.
      // Uygulama zaten 512x512'ye küçültüp gönderiyor; bu üst sınır
      // doğrudan Storage API'sine yapılacak yüklemelere karşı.
      allow write: if request.auth != null
                   && userId.matches(request.auth.uid + '.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Başka hiçbir yola yazılamaz.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
